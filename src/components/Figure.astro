---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

/**
 * Figure — image slot with a clearly-marked placeholder state.
 *
 * When `src` is supplied it renders optimised responsive imagery.
 * When it is not, it renders an annotated drawing-sheet placeholder so the
 * gap is deliberate and legible rather than broken. Every placeholder tells
 * the reader exactly what photograph belongs there.
 */
interface Props {
  /** Local image, imported in the calling component. Left empty → placeholder. */
  src?: ImageMetadata;
  alt?: string;
  /** Intrinsic dimensions of `src`, used to generate the responsive srcset. */
  width?: number;
  height?: number;
  /** Drawing-sheet reference, e.g. "01" */
  fig?: string;
  /** What the final photograph should show. */
  label: string;
  /** Aspect ratio, e.g. "4/3", "3/2", "16/10", "1/1" */
  ratio?: string;
  tone?: 'light' | 'dark';
  icon?:
    | 'building'
    | 'grid'
    | 'users'
    | 'leaf'
    | 'spark'
    | 'mic'
    | 'lamp'
    | 'compass'
    | 'book'
    | 'sun'
    | 'wind'
    | 'drop'
    | 'ruler';
  class?: string;
  /** Applied to the image/placeholder element itself — e.g. to make it fill. */
  innerClass?: string;
  /** Skip lazy-loading for above-the-fold figures. */
  priority?: boolean;
}

const {
  src,
  alt = '',
  width = 1600,
  height = 1200,
  fig,
  label,
  ratio = '4/3',
  tone = 'light',
  icon = 'grid',
  class: className = '',
  innerClass = '',
  priority = false,
} = Astro.props;

// Ratios used across the page. Keeping them in one map means Tailwind's
// scanner sees every class literal, so none of them get purged.
const ratioMap: Record<string, string> = {
  '4/3': 'aspect-[4/3]',
  '3/2': 'aspect-[3/2]',
  '16/10': 'aspect-[16/10]',
  '16/9': 'aspect-[16/9]',
  '5/4': 'aspect-[5/4]',
  '4/5': 'aspect-[4/5]',
  '1/1': 'aspect-square',
  '3/4': 'aspect-[3/4]',
  '2/3': 'aspect-[2/3]',
};
const aspect = ratioMap[ratio] ?? 'aspect-[4/3]';

const isDark = tone === 'dark';
---

<figure class={`relative overflow-hidden rounded-[2px] ${className}`}>
  {
    src ? (
      <Image
        src={src}
        alt={alt || label}
        width={width}
        height={height}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class={`${aspect} w-full object-cover ${innerClass}`}
      />
    ) : (
      <div
        class={[
          'relative w-full',
          aspect,
          innerClass,
          isDark
            ? 'bg-[linear-gradient(150deg,#241f1a_0%,#1a1613_55%,#12100e_100%)] text-sand/70'
            : 'bg-[linear-gradient(150deg,#f2ebdf_0%,#eae0d0_55%,#e0d3c0_100%)] text-ink-mute',
          'blueprint',
        ].join(' ')}
        role="img"
        aria-label={`Image placeholder — ${label}`}
      >
        {/* Corner registration ticks — reads as a drawing sheet, not a broken image */}
        <span
          aria-hidden="true"
          class={`absolute inset-3 border ${
            isDark ? 'border-sand/15' : 'border-ink/10'
          }`}
        ></span>
        {['left-3 top-3 border-l border-t', 'right-3 top-3 border-r border-t', 'left-3 bottom-3 border-l border-b', 'right-3 bottom-3 border-r border-b'].map(
          (pos) => (
            <span
              aria-hidden="true"
              class={`absolute size-3.5 ${pos} ${isDark ? 'border-sand/40' : 'border-ink/30'}`}
            />
          )
        )}

        {/* Centre mark. Colour comes from the parent so contrast stays exact
            rather than cumulative: ~5.3:1 on light sheets, ~4.7:1 on dark. */}
        <span class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
          <Icon
            name={icon}
            class={`size-7 ${isDark ? 'text-sand/58' : 'text-clay'}`}
            strokeWidth={1.25}
          />
          <span class="eyebrow text-[0.625rem] tracking-[0.2em]">
            <slot name="pending">Image pending</slot>
          </span>
        </span>

        {/* Sheet annotation */}
        <span class="absolute inset-x-5 bottom-4 flex items-end justify-between gap-4 text-left">
          {fig && <span class="eyebrow text-[0.625rem]">Fig. {fig}</span>}
          <span class="max-w-[22ch] text-right text-[0.6875rem] font-medium leading-snug">
            {label}
          </span>
        </span>
      </div>
    )
  }
</figure>
