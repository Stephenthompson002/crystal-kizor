---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

/**
 * Figure — the single image slot used everywhere on the page.
 *
 * With `src`, it renders optimised responsive imagery through Astro's pipeline
 * and carries intrinsic dimensions, so nothing shifts as it loads.
 * Without `src`, it renders an annotated drawing-sheet placeholder that names
 * the photograph that belongs there. That state is deliberate and legible
 * rather than a broken image — the brief provides for it explicitly.
 */
interface Props {
  /** Imported image from `src/data/media.ts`. Empty → placeholder. */
  src?: ImageMetadata;
  alt?: string;
  /** Drawing-sheet reference, e.g. "03". */
  fig?: string;
  /** What the final photograph should show, or the caption when filled. */
  label: string;
  /** Aspect ratio, e.g. "4/3", "3/2", "16/10", "4/5". */
  ratio?: string;
  tone?: 'light' | 'dark';
  icon?:
    | 'building'
    | 'grid'
    | 'users'
    | 'leaf'
    | 'spark'
    | 'mic'
    | 'lamp'
    | 'compass'
    | 'book'
    | 'sun'
    | 'wind'
    | 'drop'
    | 'ruler';
  class?: string;
  /** Applied to the image/placeholder element itself, e.g. to make it fill. */
  innerClass?: string;
  /** Candidate widths for the srcset. Cap these to the source's real size. */
  widths?: number[];
  sizes?: string;
  /** Skip lazy-loading for above-the-fold figures. */
  priority?: boolean;
  /** Overlay a "Visualisation" chip so a render is never read as a photo. */
  visualisation?: boolean;
}

const {
  src,
  alt = '',
  fig,
  label,
  ratio = '4/3',
  tone = 'light',
  icon = 'grid',
  class: className = '',
  innerClass = '',
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1024px) 50vw, 100vw',
  priority = false,
  visualisation = false,
} = Astro.props;

// Ratios used across the page. Keeping them in one map means Tailwind's
// scanner sees every class literal, so none of them get purged.
const ratioMap: Record<string, string> = {
  '4/3': 'aspect-[4/3]',
  '3/2': 'aspect-[3/2]',
  '16/10': 'aspect-[16/10]',
  '16/9': 'aspect-[16/9]',
  '5/4': 'aspect-[5/4]',
  '4/5': 'aspect-[4/5]',
  '1/1': 'aspect-square',
  '3/4': 'aspect-[3/4]',
  '2/3': 'aspect-[2/3]',
};
const aspect = ratioMap[ratio] ?? 'aspect-[4/3]';

const isDark = tone === 'dark';
---

<figure class={`relative ${className}`}>
  {
    src ? (
      <div class="relative overflow-hidden rounded-[2px]">
        <Image
          src={src}
          alt={alt || label}
          widths={widths}
          sizes={sizes}
          loading={priority ? 'eager' : 'lazy'}
          decoding={priority ? 'sync' : 'async'}
          fetchpriority={priority ? 'high' : 'auto'}
          class={`${aspect} w-full object-cover ${innerClass}`}
        />
        {visualisation && (
          <span class="absolute bottom-3 right-3 rounded-[2px] bg-night/70 px-2.5 py-1.5 text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-linen backdrop-blur-[2px]">
            Visualisation
          </span>
        )}
      </div>
    ) : (
      <div
        class={[
          'relative w-full overflow-hidden rounded-[2px]',
          aspect,
          innerClass,
          isDark
            ? 'bg-[linear-gradient(150deg,#241f1a_0%,#1a1613_55%,#12100e_100%)] text-sand/70'
            : 'bg-[linear-gradient(150deg,#f2ebdf_0%,#eae0d0_55%,#e0d3c0_100%)] text-ink-soft',
          'blueprint',
        ].join(' ')}
        role="img"
        aria-label={`Image placeholder — ${label}`}
      >
        {/* Corner registration ticks — reads as a drawing sheet, not a broken image */}
        <span
          aria-hidden="true"
          class={`absolute inset-3 border ${isDark ? 'border-sand/15' : 'border-ink/10'}`}
        ></span>
        {[
          'left-3 top-3 border-l border-t',
          'right-3 top-3 border-r border-t',
          'left-3 bottom-3 border-l border-b',
          'right-3 bottom-3 border-r border-b',
        ].map((pos) => (
          <span
            aria-hidden="true"
            class={`absolute size-3.5 ${pos} ${isDark ? 'border-sand/40' : 'border-ink/30'}`}
          />
        ))}

        {/* Centre mark. Colour comes from the parent so contrast stays exact
            rather than cumulative: the label is ink-soft on light sheets
            (≥7.5:1 even over the darkest gradient stop) and sand/58 on dark. */}
        <span class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
          <Icon
            name={icon}
            class={`size-7 ${isDark ? 'text-sand/58' : 'text-clay'}`}
            strokeWidth={1.25}
          />
          <span class="eyebrow text-[0.625rem] tracking-[0.2em]">
            <slot name="pending">Photography pending</slot>
          </span>
        </span>

        {/* Sheet annotation */}
        <span class="absolute inset-x-5 bottom-4 flex items-end justify-between gap-4 text-left">
          {fig && <span class="eyebrow text-[0.625rem]">Fig. {fig}</span>}
          <span class="max-w-[24ch] text-right text-[0.6875rem] font-medium leading-snug">
            {label}
          </span>
        </span>
      </div>
    )
  }

  {
    /* When a real image is present the label becomes a caption underneath,
       so the drawing-sheet annotation is never lost. */
    src && label && alt === '' && (
      <figcaption class="mt-3 text-[0.6875rem] leading-snug text-ink-mute">{label}</figcaption>
    )
  }
</figure>
