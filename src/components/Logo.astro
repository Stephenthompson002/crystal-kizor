---
/**
 * Logo — the supplied Crystal Kizor identity.
 *
 * The marks are the real ones, extracted from the brand's logo sheet by
 * `scripts/prepare-assets.mjs`: background knocked out, alpha re-normalised,
 * and the artwork recoloured to exact token values so it sits on linen, sand
 * or night without a cream plate behind it.
 *
 *   lockup="monogram"  the CK monogram — used in the header, where a horizontal
 *                      wordmark would crowd the navigation.
 *   lockup="wordmark"  the primary stacked CRYSTAL KIZOR lockup, used in the
 *                      footer at a size that earns the detail.
 */
import { asset } from '../lib/url';
interface Props {
  lockup?: 'monogram' | 'wordmark' | 'primary';
  tone?: 'light' | 'dark';
  class?: string;
  /**
   * Hide the mark from assistive technology, for when the element that wraps
   * it already carries the accessible name (the header link, for instance).
   * The `alt` text is kept on the image so it still appears if images fail.
   */
  decorative?: boolean;
  /** The header mark is above the fold; the footer mark is not. */
  priority?: boolean;
}

const {
  lockup = 'monogram',
  tone = 'light',
  class: className = '',
  decorative = false,
  priority = false,
} = Astro.props;

// Ink on light grounds, linen on dark ones — both exported at exact token values.
const src =
  lockup === 'monogram'
    ? tone === 'dark'
      ? asset('/brand/monogram-linen.png')
      : asset('/brand/monogram-ink.png')
    : tone === 'dark'
      ? asset('/brand/primary-lockup-linen.png')
      : asset('/brand/primary-lockup-ink.png');

const size = lockup === 'monogram' ? 'h-9 w-auto md:h-10' : 'w-[9.5rem] sm:w-[11rem]';

const alt = lockup === 'monogram' ? 'Crystal Kizor monogram' : 'Crystal Kizor';
---

<img
  src={src}
  alt={alt}
  aria-hidden={decorative ? 'true' : undefined}
  width={lockup === 'monogram' ? 183 : 440}
  height={lockup === 'monogram' ? 144 : 196}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  class={`block select-none ${size} ${className}`}
/>
