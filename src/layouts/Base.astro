---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { meta } from '../data/site';
import { absolute, asset } from '../lib/url';
import frauncesUrl from '../assets/fonts/fraunces-var.woff2?url';
import instrumentSansUrl from '../assets/fonts/instrument-sans-var.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${meta.name} — ${meta.role}`,
  description = 'Architect, designer and founder of Studio COKA. Climate-responsive architecture and interiors in Nigeria — including Nigeria’s first fully off-grid hospital.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? meta.site).href;
const ogImage = absolute('/og.png', Astro.site, meta.site);

/**
 * Structured data. Kept factual and conservative: the Person node describes
 * Crystal, and `knowsAbout` uses only publicly stated areas of practice.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${meta.site}/#person`,
      name: 'Crystal Kizor',
      jobTitle: 'Architect, Designer and Founder of Studio COKA',
      description:
        'Architect, interior designer, entrepreneur and speaker based in Nigeria. Founder and lead principal of Studio COKA, architect of Nigeria’s first fully off-grid hospital.',
      url: meta.site,
      image: ogImage,
      email: `mailto:${meta.email}`,
      address: { '@type': 'PostalAddress', addressCountry: 'NG', addressRegion: 'Enugu' },
      worksFor: { '@id': `${meta.site}/#studiocoka` },
      knowsAbout: [
        'Climate-responsive architecture',
        'Passive cooling and natural ventilation',
        'Daylighting design',
        'Tropical architecture',
        'Indigenous building strategies',
        'Interior design',
      ],
      sameAs: [
        'https://www.instagram.com/crystalkizor/',
        'https://x.com/crystal_kizor',
        'https://www.linkedin.com/in/crystal-kizor/',
      ],
    },
    {
      '@type': 'Organization',
      '@id': `${meta.site}/#studiocoka`,
      name: 'Studio COKA',
      description:
        'A climate-responsive architecture, interior design and design-build studio working in Nigeria and across West Africa.',
      url: 'https://studiocoka.com',
      logo: `${meta.site}/favicon.svg`,
      founder: { '@id': `${meta.site}/#person` },
      areaServed: 'West Africa',
    },
    { '@type': 'WebSite', '@id': `${meta.site}/#website`, url: meta.site, name: meta.name },
  ],
};

// Set by an inline script so the "no-JS" state stays fully visible and legible.
const themeColor = '#faf7f2';
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@crystal_kizor" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts are on the critical path: preload both so the hero paints in the
         brand face rather than swapping a beat later. -->
    <link
      rel="preload"
      href={frauncesUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={instrumentSansUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/site.webmanifest')} />

    <Fragment
      set:html={`<script type="application/ld+json">${JSON.stringify(jsonLd).replace(
        /</g,
        '\\u003c'
      )}</script>`}
    />

    <script is:inline>
      // Marks that JS is available, which opts the page into scroll-reveal
      // transitions. Without JS everything is visible immediately.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="min-h-dvh bg-linen text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[2px] focus:bg-ink focus:px-4 focus:py-3 focus:text-small focus:font-semibold focus:text-linen"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // -----------------------------------------------------------------------
      // Scroll reveal. Purely additive: the markup is complete and visible
      // without JavaScript, and the `js` class is the only thing that opts the
      // page into the transition. Reduced-motion users skip it entirely (CSS).
      // -----------------------------------------------------------------------
      const revealables = document.querySelectorAll('[data-reveal]');

      if (revealables.length > 0) {
        if (!('IntersectionObserver' in window)) {
          document.documentElement.classList.remove('js');
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.04 }
          );

          revealables.forEach((el) => observer.observe(el));
        }
      }

      // -----------------------------------------------------------------------
      // Measurement hook. Nothing leaves the browser unless an analytics
      // provider is loaded — but the intent of every CTA is already declared in
      // the markup via `data-track`, so wiring Plausible, GA4, PostHog or
      // Vercel Analytics later is a one-line addition, not a re-instrumentation.
      // -----------------------------------------------------------------------
      document.addEventListener(
        'click',
        (event) => {
          const target = event.target as HTMLElement | null;
          const el = target?.closest<HTMLElement>('[data-track]');
          if (!el) return;

          const cta = el.getAttribute('data-track');
          if (!cta) return;

          const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
          w.dataLayer = w.dataLayer ?? [];
          w.dataLayer.push({
            event: 'cta_click',
            cta,
            href: el.getAttribute('href') ?? null,
            section: el.closest('section')?.id ?? null,
          });
        },
        { passive: true }
      );
    </script>
  </body>
</html>
