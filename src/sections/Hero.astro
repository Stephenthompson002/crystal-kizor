---
import Button from '../components/Button.astro';
import Figure from '../components/Figure.astro';
import Icon from '../components/Icon.astro';
import { meta } from '../data/site';
import portraitHero from '../assets/work/portrait-hero.webp';

const projectMailto = `mailto:${meta.email}?subject=Project%20enquiry%20%E2%80%94%20Studio%20COKA`;

// The three layers of the ecosystem: the answer to "what is she building?",
// stated once, plainly, and above the fold.
const layers = [
  {
    label: 'The practice',
    value: 'Studio COKA',
    note: 'Climate-responsive architecture, interiors and design-build.',
    href: '#studio-coka',
  },
  {
    label: 'The teaching',
    value: 'The Effective Architect',
    note: 'Practical tropical design for architects and students.',
    href: '#knowledge',
  },
  {
    label: 'The initiatives',
    value: 'Three more ventures',
    note: 'Furniture, education access, and a youth movement.',
    href: '#initiatives',
  },
];
---

<section id="top" class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24">
  <!-- Warm ground: a soft light source top-right, the way a good plan is lit. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(120%_85%_at_88%_-10%,rgb(192_138_62/0.14)_0%,transparent_58%),radial-gradient(90%_70%_at_-10%_20%,rgb(169_73_31/0.06)_0%,transparent_55%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="blueprint pointer-events-none absolute inset-0 -z-10 opacity-70 [mask-image:radial-gradient(75%_60%_at_50%_0%,#000_0%,transparent_85%)]"
  >
  </div>

  <div class="shell">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-0">
      <!-- Copy -->
      <div class="flex flex-col lg:col-span-7">
        <p class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-2 text-ink-soft" data-reveal>
          <span class="inline-flex items-center gap-2 text-clay">
            <span aria-hidden="true" class="inline-block h-px w-6 bg-clay/50"></span>
            Architect
          </span>
          <span aria-hidden="true" class="text-ink-mute">·</span>
          <span>Designer</span>
          <span aria-hidden="true" class="text-ink-mute">·</span>
          <span>Founder, Studio COKA</span>
        </p>

        <h1 class="mt-7 text-h1 text-ink" data-reveal style="--reveal-delay:60ms">
          Design for the climate<br class="hidden sm:block" />
          <span class="text-clay">you actually have.</span>
        </h1>

        <p
          class="mt-7 max-w-[52ch] text-lead leading-[1.6] text-ink-soft"
          data-reveal
          style="--reveal-delay:120ms"
        >
          Crystal Kizor is an architect, designer and entrepreneur working across Nigeria and West
          Africa. She built <strong class="font-semibold text-ink"
            >Nigeria’s first fully off-grid hospital</strong
          > — and now leads a group of ventures that design, teach and advocate for buildings that
          stay cool, use daylight, and hold up in the climate they stand in.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:180ms">
          <Button href={projectMailto} size="lg" icon="arrow-right" data-track="hero-start-project">
            Start a project
          </Button>
          <Button href="#work" variant="outline" size="lg" icon="arrow-down" data-track="hero-see-work">
            See the work
          </Button>
        </div>
      </div>

      <!-- Imagery -->
      <div class="lg:col-span-5" data-reveal style="--reveal-delay:160ms">
        <div class="relative">
          <Figure
            src={portraitHero}
            width={1200}
            height={1500}
            alt="Crystal Kizor leaning on a stone-topped drawing table in her studio, with plans and material samples behind her and a city view through the window"
            ratio="4/5"
            sizes="(min-width: 1024px) 42vw, 100vw"
            priority
            class="shadow-lift-lg"
          />

          <!-- Overlaid proof card: the flagship result, kept adjacent to the
               claim it supports. Anchored bottom-right and overhanging only
               vertically, so it can never collide with the page gutter. -->
          <div
            class="absolute -bottom-7 right-4 w-[15.5rem] rounded-[2px] border border-sand-deep bg-paper p-5 shadow-lift-lg sm:right-6 sm:w-[17rem]"
          >
            <p class="eyebrow text-clay">Flagship project</p>
            <p class="mt-2.5 font-display text-[1.1875rem] leading-[1.2] text-ink">
              Nigeria’s first fully off-grid hospital
            </p>
            <p class="mt-2.5 text-micro leading-relaxed text-ink-soft">
              The Eye Specialists Hospital, Nsukka — 100% of power generated on site.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- The three-layer statement, given its own full-width band. -->
    <dl
      class="mt-20 grid grid-cols-1 gap-px overflow-hidden rounded-[2px] border border-sand-deep bg-sand-deep sm:grid-cols-3"
      data-reveal
      style="--reveal-delay:220ms"
    >
      {
        layers.map((layer) => (
          <div class="group bg-linen/85">
            <a
              href={layer.href}
              class="flex h-full flex-col gap-2.5 p-6 transition-colors duration-200 hover:bg-sand/70 lg:p-7"
              data-track={`hero-layer-${layer.label.toLowerCase().replace(/\s+/g, '-')}`}
            >
              <span class="eyebrow text-ink-mute">{layer.label}</span>
              <span class="flex items-center gap-2 font-display text-h4 leading-tight text-ink">
                {layer.value}
                <Icon
                  name="arrow-right"
                  class="size-4 shrink-0 text-clay transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover:translate-x-1"
                  strokeWidth={2}
                />
              </span>
              <span class="text-micro leading-relaxed text-ink-soft">{layer.note}</span>
            </a>
          </div>
        ))
      }
    </dl>
  </div>
</section>
